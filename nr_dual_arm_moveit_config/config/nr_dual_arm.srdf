<?xml version="1.0" ?>
<robot name="nr_dual_arm">
  <group name="uf850_arm">
    <chain base_link="uf850_base_link" tip_link="rg6_tcp"/>
  </group>
  <group name="uf850_tool">
    <link name="rg6_tcp"/>
  </group>

  <group name="xarm5_arm">
    <chain base_link="base_link" tip_link="xarm_gripper_tcp"/>
  </group>

  <group name="xarm5_arm_no_slide">
    <chain base_link="xarm5_base_link" tip_link="xarm_gripper_tcp"/>
  </group>

  <group name="xarm5_tool">
    <link name="xarm_gripper_tcp"/>
  </group>

  <group name="rg6_gripper">
    <joint name="rg6_right_drive_joint"/>
  </group>

  <group name="xarm_gripper">
    <joint name="xarm_gripper_right_drive_joint"/>
  </group>

  <group name="dual_arms">
    <group name="uf850_arm"/>
    <group name="xarm5_arm"/>
  </group>

  <group_state name="home" group="uf850_arm">
    <joint name="uf850_joint1" value="0.0"/>
    <joint name="uf850_joint2" value="0.0"/>
    <joint name="uf850_joint3" value="-1.57079632679"/>
    <joint name="uf850_joint4" value="0.0"/>
    <joint name="uf850_joint5" value="-1.57079632679"/>
    <joint name="uf850_joint6" value="0.0"/>
  </group_state>

  <group_state name="home" group="xarm5_arm">
    <joint name="uf_slide_joint" value="0.054"/>
    <joint name="xarm5_joint1" value="0.0"/>
    <joint name="xarm5_joint2" value="0.0"/>
    <joint name="xarm5_joint3" value="-1.57079632679"/>
    <joint name="xarm5_joint4" value="1.57079632679"/>
    <joint name="xarm5_joint5" value="0.0"/>
  </group_state>

  <group_state name="home" group="xarm5_arm_no_slide">
    <joint name="xarm5_joint1" value="0.0"/>
    <joint name="xarm5_joint2" value="0.0"/>
    <joint name="xarm5_joint3" value="-1.57079632679"/>
    <joint name="xarm5_joint4" value="1.57079632679"/>
    <joint name="xarm5_joint5" value="0.0"/>
  </group_state>

  <group_state name="home" group="dual_arms">
    <joint name="uf_slide_joint" value="0.054"/>
    <joint name="uf850_joint1" value="0.0"/>
    <joint name="uf850_joint2" value="0.0"/>
    <joint name="uf850_joint3" value="-1.57079632679"/>
    <joint name="uf850_joint4" value="0.0"/>
    <joint name="uf850_joint5" value="-1.57079632679"/>
    <joint name="uf850_joint6" value="0.0"/>
    <joint name="xarm5_joint1" value="0.0"/>
    <joint name="xarm5_joint2" value="0.0"/>
    <joint name="xarm5_joint3" value="-1.57079632679"/>
    <joint name="xarm5_joint4" value="1.57079632679"/>
    <joint name="xarm5_joint5" value="0.0"/>
  </group_state>

  <group_state name="open" group="rg6_gripper">
    <joint name="rg6_right_drive_joint" value="-0.625"/>
  </group_state>

  <group_state name="closed" group="rg6_gripper">
    <joint name="rg6_right_drive_joint" value="0.625"/>
  </group_state>

  <group_state name="open" group="xarm_gripper">
    <joint name="xarm_gripper_right_drive_joint" value="0.0"/>
  </group_state>

  <group_state name="closed" group="xarm_gripper">
    <joint name="xarm_gripper_right_drive_joint" value="0.854"/>
  </group_state>

  <end_effector name="rg6" parent_link="uf850_link6" group="uf850_tool" parent_group="uf850_arm"/>
  <end_effector name="xarm_gripper" parent_link="xarm5_link5" group="xarm5_tool" parent_group="xarm5_arm"/>
  <end_effector name="xarm_gripper_no_slide" parent_link="xarm5_link5" group="xarm5_tool" parent_group="xarm5_arm_no_slide"/>

  <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="base_link"/>

  <passive_joint name="rg6_right_inner_joint"/>
  <passive_joint name="rg6_left_drive_joint"/>
  <passive_joint name="rg6_left_inner_joint"/>
  <passive_joint name="rg6_right_finger_joint"/>
  <passive_joint name="rg6_left_finger_joint"/>
  <passive_joint name="rg6_right_ignore_joint"/>
  <passive_joint name="rg6_left_ignore_joint"/>
  <passive_joint name="xarm_gripper_left_drive_joint"/>
  <passive_joint name="xarm_gripper_left_inner_joint"/>
  <passive_joint name="xarm_gripper_right_inner_joint"/>
  <passive_joint name="xarm_gripper_left_finger_joint"/>
  <passive_joint name="xarm_gripper_right_finger_joint"/>
  <passive_joint name="xarm_gripper_left_ignore_joint"/>
  <passive_joint name="xarm_gripper_right_ignore_joint"/>

  <disable_collisions link1="base_link" link2="uf850_mount" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="uf_linear_slide" reason="Adjacent"/>
  <disable_collisions link1="uf850_mount" link2="uf850_base_link" reason="Adjacent"/>
  <disable_collisions link1="uf_linear_slide" link2="robot_base" reason="Adjacent"/>
  <disable_collisions link1="robot_base" link2="xarm5_base_link" reason="Adjacent"/>

  <disable_collisions link1="uf850_base_link" link2="uf850_link1" reason="Adjacent"/>
  <disable_collisions link1="uf850_link1" link2="uf850_link2" reason="Adjacent"/>
  <disable_collisions link1="uf850_link2" link2="uf850_link3" reason="Adjacent"/>
  <disable_collisions link1="uf850_link3" link2="uf850_link4" reason="Adjacent"/>
  <disable_collisions link1="uf850_link4" link2="uf850_link5" reason="Adjacent"/>
  <disable_collisions link1="uf850_link5" link2="uf850_link6" reason="Adjacent"/>
  <disable_collisions link1="uf850_link6" link2="rg6_base_link" reason="Adjacent"/>

  <disable_collisions link1="rg6_base_link" link2="rg6_Back_body" reason="Adjacent"/>
  <disable_collisions link1="rg6_base_link" link2="rg6_Front_body" reason="Adjacent"/>
  <disable_collisions link1="rg6_base_link" link2="rg6_tcp" reason="Adjacent"/>
  <disable_collisions link1="rg6_base_link" link2="rg6_R_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="rg6_base_link" link2="rg6_L_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="rg6_base_link" link2="rg6_R_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="rg6_base_link" link2="rg6_L_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="rg6_Back_body" link2="rg6_Front_body" reason="Adjacent"/>
  <disable_collisions link1="rg6_Back_body" link2="rg6_R_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="rg6_Back_body" link2="rg6_R_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="rg6_Back_body" link2="rg6_L_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="rg6_Back_body" link2="rg6_L_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="rg6_Front_body" link2="rg6_R_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="rg6_Front_body" link2="rg6_L_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="rg6_Front_body" link2="rg6_R_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="rg6_Front_body" link2="rg6_L_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="rg6_Front_body" link2="rg6_R_finger" reason="Adjacent"/>
  <disable_collisions link1="rg6_Front_body" link2="rg6_L_finger" reason="Adjacent"/>
  <disable_collisions link1="rg6_R_inner_knuckle" link2="rg6_R_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="rg6_L_inner_knuckle" link2="rg6_L_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="rg6_R_inner_knuckle" link2="rg6_R_finger" reason="Adjacent"/>
  <disable_collisions link1="rg6_L_inner_knuckle" link2="rg6_L_finger" reason="Adjacent"/>
  <disable_collisions link1="rg6_R_outer_knuckle" link2="rg6_R_finger" reason="Adjacent"/>
  <disable_collisions link1="rg6_L_outer_knuckle" link2="rg6_L_finger" reason="Adjacent"/>
  <disable_collisions link1="rg6_L_finger" link2="rg6_R_finger" reason="Adjacent"/>

  <disable_collisions link1="xarm5_base_link" link2="xarm5_link1" reason="Adjacent"/>
  <disable_collisions link1="xarm5_link1" link2="xarm5_link2" reason="Adjacent"/>
  <disable_collisions link1="xarm5_link2" link2="xarm5_link3" reason="Adjacent"/>
  <disable_collisions link1="xarm5_link3" link2="xarm5_link4" reason="Adjacent"/>
  <disable_collisions link1="xarm5_link4" link2="xarm5_link5" reason="Adjacent"/>
  <disable_collisions link1="xarm5_link5" link2="FT300" reason="Adjacent"/>
  <disable_collisions link1="FT300" link2="xarm5_camera_stand" reason="Adjacent"/>
  <disable_collisions link1="xarm5_camera_stand" link2="xarm_gripper_base_link" reason="Adjacent"/>
  <disable_collisions link1="xarm_gripper_base_link" link2="xarm_gripper_tcp" reason="Adjacent"/>
  <disable_collisions link1="xarm_gripper_base_link" link2="xarm_gripper_left_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="xarm_gripper_base_link" link2="xarm_gripper_right_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="xarm_gripper_base_link" link2="xarm_gripper_left_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="xarm_gripper_base_link" link2="xarm_gripper_right_inner_knuckle" reason="Adjacent"/>
  <disable_collisions link1="xarm_gripper_left_inner_knuckle" link2="xarm_gripper_left_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="xarm_gripper_right_inner_knuckle" link2="xarm_gripper_right_outer_knuckle" reason="Adjacent"/>
  <disable_collisions link1="xarm_gripper_left_inner_knuckle" link2="xarm_gripper_left_finger" reason="Adjacent"/>
  <disable_collisions link1="xarm_gripper_right_inner_knuckle" link2="xarm_gripper_right_finger" reason="Adjacent"/>
  <disable_collisions link1="xarm_gripper_left_outer_knuckle" link2="xarm_gripper_left_finger" reason="Adjacent"/>
  <disable_collisions link1="xarm_gripper_right_outer_knuckle" link2="xarm_gripper_right_finger" reason="Adjacent"/>
  <disable_collisions link1="xarm_gripper_left_finger" link2="xarm_gripper_right_finger" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="rg6_L_inner_knuckle" reason="Never"/>
  <disable_collisions link1="base_link" link2="rg6_R_inner_knuckle" reason="Never"/>
  <disable_collisions link1="rg6_R_inner_knuckle" link2="xarm_gripper_base_link" reason="Never"/>
  <disable_collisions link1="rg6_R_inner_knuckle" link2="xarm_gripper_left_outer_knuckle" reason="Never"/>
</robot>
